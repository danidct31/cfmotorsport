generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListKind {
  PRIMARY
  WEEKLY
  TODO
  DESK
}

model JobItem {
  id        String    @id @default(cuid())
  kind      ListKind
  text      String
  checked   Boolean   @default(false)
  dueDate   DateTime?
  priority  Int       @default(3)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind])
  @@index([kind, priority])
}

model JobNote {
  id        String   @id @default(cuid())
  parentId  String
  text      String
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}
